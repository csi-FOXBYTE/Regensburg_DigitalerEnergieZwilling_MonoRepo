# Copy this file to .env at the repository root and replace these URLs.
# Tiles and terrain values are base URLs; the address database is a complete file URL.
# All three resources must be reachable from the browser.
TILES_URL=https://example.invalid/tiles
TERRAIN_URL=https://example.invalid/terrain
ADDRESS_DATABASE_URL=https://example.invalid/addresses.sqlite


# Feedback notifications require all three settings. The devcontainer supplies
# local defaults for all three via Mailpit; view messages at localhost:8025.
# MAIL_FROM is the sender; FEEDBACK_MAIL_TO is the internal notification inbox.
# SMTP_URL=smtps://user:password@smtp.example.invalid:465
# MAIL_FROM=Digitaler Energiezwilling <noreply@example.invalid>
# FEEDBACK_MAIL_TO=feedback@example.invalid

# Optional Matomo web analytics. Leave both empty to keep tracking dormant.
# For the devcontainer's local Matomo (--profile matomo, see README.md) use
# MATOMO_URL=http://localhost:8091/matomo.php and MATOMO_SITE_ID=1.
# Use a separate site ID per environment; never share the production site.
# Only set them in production once privacy notice section 12 is completed with
# the instance's approved settings and its "activation pending" note removed.
# MATOMO_URL=https://matomo.example.invalid/matomo.php
# MATOMO_SITE_ID=1

