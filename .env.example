# Copy this file to .env at the repository root and replace these URLs.
# Tiles and terrain values are base URLs; the address database is a complete file URL.
# All three resources must be reachable from the browser.
TILES_URL=https://example.invalid/tiles
TERRAIN_URL=https://example.invalid/terrain
ADDRESS_DATABASE_URL=https://example.invalid/addresses.sqlite

# Optional Matomo web analytics. Leave both empty to keep tracking dormant.
# The devcontainer sets both to its local Matomo (.devcontainer/compose.yml).
# Use a separate site ID per environment; never share the production site.
# Only set them in production together with the approved operating parameters and
# an updated privacy notice section 12 (it still says Matomo is not active).
# MATOMO_URL=https://matomo.example.invalid/matomo.php
# MATOMO_SITE_ID=1
