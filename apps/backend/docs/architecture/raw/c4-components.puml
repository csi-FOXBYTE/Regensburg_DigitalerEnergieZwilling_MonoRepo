@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
HIDE_STEREOTYPE()

title Digitaler Energie Zwilling (DEZ) - C4-Komponentendiagramm (Frontends)

Person(citizen, "Bürger/Eigentümer/Vermieter")
Person(admin, "Stadtverwaltung/Fachpersonal")

System_Boundary(civitas, "CIVITAS/CORE-Plattform") {
  Container(gateway, "APISIX-Web-/API-Gateway", "API-Gateway und Reverse-Proxy", "Einziger öffentlicher Einstiegspunkt und Routenschutz")

  Container_Boundary(frontendPublic, "Bereitstellung des öffentlichen Frontends", "Separates Repository mit Astro SSG + nginx") {
    Component(publicBuild, "Öffentlicher Astro-Build", "Astro", "Erzeugt die öffentliche statische Anwendung")
    Component(publicClient, "Öffentlicher Client", "React und Cesium", "3D-Ansicht, Gebäudeauswahl und Bedienoberfläche der Energieberechnung")
  }

  Container_Boundary(frontendAdmin, "Bereitstellung des Admin-Frontends", "Separates Repository mit Astro SSG + nginx") {
    Component(adminBuild, "Admin-Astro-Build", "Astro", "Erzeugt die administrative statische Anwendung")
    Component(adminClient, "Admin-Client", "React", "Bedienoberfläche für Konfiguration, Einreichungen und Triage")
  }

  Container(backendApi, "Backend-API", "Node und Fastify", "REST-APIs, Tokenvalidierung, PostgreSQL-Persistenz und Kachelweiterleitungen")
  Container(calcCore, "Berechnungskern-Modul", "JavaScript-Modulpaket", "Läuft im öffentlichen Browser-Client")
}

System_Ext(geo, "Städtische Geodienste", "WMS- und WMTS-Basiskarten")
System_Ext(staticTiles, "Externer Kacheldienst", "Bei der Bereitstellung vorgegebenes, über TILES_URL konfiguriertes Ziel")
System_Ext(vegetation, "Vegetation (Bäume) (3D Tiles)", "Externe visuelle Ebene für die öffentliche Kartendarstellung")

Rel(citizen, gateway, "nutzt das öffentliche Frontend", "HTTPS")
Rel(admin, gateway, "nutzt das Admin-Frontend", "HTTPS")
Rel(gateway, publicClient, "leitet die öffentliche Website weiter", "GET /")
Rel(gateway, adminClient, "leitet die Admin-Website weiter", "GET /admin")
Rel(gateway, backendApi, "leitet APIs weiter", "GET/POST /api")

Rel(publicBuild, publicClient, "erzeugt die statische Anwendung")
Rel(adminBuild, adminClient, "erzeugt die statische Anwendung")

Rel(publicClient, gateway, "fordert 3D Tiles an", "GET /api/public/tiles/*")
Rel(backendApi, staticTiles, "leitet zum konfigurierten Ziel weiter", "HTTP 3xx")
Rel(publicClient, geo, "lädt Basiskarten")
Rel(publicClient, vegetation, "lädt die Vegetationsebene (nur visuell)")
Rel(publicClient, backendApi, "lädt die Konfiguration und sendet optionale Nutzereingaben", "REST über APISIX")
Rel(adminClient, backendApi, "triagiert Nutzereingaben und verwaltet die Konfiguration", "REST über APISIX")
Rel(publicClient, calcCore, "importiert und führt lokal aus", "Browser-Laufzeit")

note right of frontendPublic
Eigenständiges Repository, eigener Build,
eigenes Container-Abbild und eigene nginx-Bereitstellung.
end note

note right of frontendAdmin
Eigenständiges Repository, eigener Build,
eigenes Container-Abbild und eigene nginx-Bereitstellung.
end note

@enduml
