{
  "name": "rg-dez-backend",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "oxlint --ignore-pattern \"src/@internals/**\" && eslint",
    "dev": "fastify-toab dev",
    "build": "fastify-toab build",
    "jwt:dev": "node scripts/create-dev-jwt.mjs",
    "db:reset": "zenstack migrate reset --schema src/zenstack/schema.zmodel",
    "sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "zenstack generate --schema src/zenstack/schema.zmodel && fastify-toab rebuild"
  },
  "zenstack": {
    "schema": "src/zenstack/schema.zmodel"
  },
  "files": [
    "src/zenstack/schema.zmodel",
    "src/zenstack/migrations/",
    "COPYING",
    "COPYING.LESSER",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [],
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/cors": "^11.2.0",
    "@types/node": "^25.0.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.9.0",
    "eslint-plugin-oxlint": "^1.79.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bull-board/api": "^6.15.0",
    "@bull-board/fastify": "^6.15.0",
    "@csi-foxbyte/fastify-toab": "https://registry.npmjs.org/@csi-foxbyte/fastify-toab/-/fastify-toab-0.2.0-rc.4.tgz",
    "@csi-foxbyte/regensburg_digitalerenergiezwilling_energycalculationcore": "workspace:*",
    "@fastify/multipart": "^9.3.0",
    "@fastify/otel": "^0.16.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/under-pressure": "^9.0.3",
    "@sinclair/typebox": "^0.34.41",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.5",
    "@zenstackhq/cli": "^3.3.3",
    "@zenstackhq/orm": "^3.3.3",
    "bullmq": "^5.66.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "fastify": "^5.12.2",
    "handlebars": "^4.7.10",
    "jose": "^6.2.3",
    "nodemailer": "^10.1.4",
    "oxlint": "~1.79.0",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tiny-glob": "^0.2.9",
    "tsx": "^4.21.0",
    "zod": "^4.0.0"
  },
  "private": true
}
