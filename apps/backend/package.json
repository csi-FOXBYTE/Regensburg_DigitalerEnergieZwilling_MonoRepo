{
  "name": "rg-dez-backend",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "oxlint --ignore-pattern \"src/@internals/**\" && eslint",
    "dev": "tsx scripts/toab.ts dev",
    "build": "tsc --noEmit && tsx scripts/toab.ts build",
    "jwt:dev": "node scripts/create-dev-jwt.mjs",
    "db:reset": "zenstack migrate reset --schema src/zenstack/schema.zmodel",
    "sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "tsc --noEmit",
    "generate": "zenstack generate --schema src/zenstack/schema.zmodel && tsx scripts/toab.ts rebuild"
  },
  "zenstack": {
    "schema": "src/zenstack/schema.zmodel"
  },
  "files": [
    "src/zenstack/schema.zmodel",
    "src/zenstack/migrations/",
    "COPYING",
    "COPYING.LESSER",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [],
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.9.0",
    "eslint-plugin-oxlint": "^1.79.0",
    "jsonwebtoken": "^9.0.3",
    "rolldown": "^1.2.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@csi-foxbyte/regensburg_digitalerenergiezwilling_energycalculationcore": "workspace:*",
    "@fastify/ajv-compiler": "^4.0.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/otel": "^0.16.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/under-pressure": "^9.2.1",
    "@sinclair/typebox": "^0.34.52",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.5",
    "@zenstackhq/cli": "^3.3.3",
    "@zenstackhq/orm": "^3.3.3",
    "altcha-lib": "2.8.0",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.1",
    "esbuild-plugin-copy": "^2.1.1",
    "fastify": "^5.12.8",
    "handlebars": "^4.7.10",
    "jose": "^6.2.3",
    "nodemailer": "^10.1.0",
    "oxlint": "~1.79.0",
    "pg": "^8.19.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tiny-glob": "^0.2.9",
    "tsx": "^4.21.0",
    "zod": "^4.0.0"
  },
  "private": true
}
