datasource db {
  provider = 'postgresql'
  url      = env('DATABASE_URL')
}

plugin typescript {
  provider = "@core/typescript"
  importWithFileExtension = ".js"
}

type WithTimestamps {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Base {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User id is the Keycloak sub — provided externally, no auto-default
model User with WithTimestamps {
  id                   String                         @id
  email                String                         @unique
  given_name           String?
  family_name          String?
  assignments          Submission[]
  changeHistoryEntreis SubmissionChangeHistoryEntry[]
}

model Config with Base {
  versionName       String       @unique
  isActive          Boolean      @default(false)
  publishedAt       DateTime?
  calculationConfig String
  subsidies         String[]
  submissions       Submission[]
}

enum BuildingDataSource {
  NONE
  USER
  ACTUAL
}

enum SubmissionStatus {
  NEW
  ASSIGNED
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum DeletionAuditAction {
  SUBMISSION_DELETE
  BUILDING_SUBMISSIONS_DELETE
}

enum DeletionAuditActorType {
  ADMIN
  PUBLIC_CAPABILITY
}

enum FeedbackCategory {
  bug
  feedback
  suggestion
}

model Building with WithTimestamps {
  id          String             @id
  address     String?
  longitude   Float?
  latitude    Float?
  dataSource  BuildingDataSource @default(NONE)
  submissions Submission[]
}

model Submission with Base {
  deletionToken String                         @unique @default(nanoid())

  status        SubmissionStatus
  assignedToId  String?
  assignedTo    User?                          @relation(fields: [assignedToId], references: [id])
  assignedAt    DateTime?
  history       SubmissionChangeHistoryEntry[]

  buildingId    String
  building      Building                       @relation(fields: [buildingId], references: [id])
  address       String
  longitude     Float
  latitude      Float

  ngsiData      String
  rawInput      String
  // Null means the submission was calculated with the virtual default config
  // (no persisted Config row to reference).
  usedConfigId  String?
  usedConfig    Config?                        @relation(fields: [usedConfigId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([assignedToId, status])
}

model SubmissionChangeHistoryEntry with Base {
  from         SubmissionStatus
  to           SubmissionStatus
  byId         String
  by           User             @relation(fields: [byId], references: [id])
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  comment      String?
  relatedSubmissionId String?

  @@index([submissionId])
}

// Independent of Submission and Building by design: a deletion audit event
// survives physical deletion without retaining a target identifier. The
// receipt commitment can only be linked to a target when the caller presents
// the random verification secret returned in the deletion receipt.
model DeletionAuditEvent {
  id                String                 @id
  createdAt         DateTime               @default(now())
  action            DeletionAuditAction
  actorType         DeletionAuditActorType
  actorUserId       String?
  actorRole         String?
  deletedCount      Int
  receiptCommitment String                 @unique

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model Feedback with Base {
  category     FeedbackCategory
  message      String
  emailAddress String?

  @@index([createdAt, id])
  @@index([category, id])
}
