---
import ContentContainer from '@/components/layouts/ContentContainer.astro';
import EnergyCalculationPage from '@/components/layouts/EnergyCalculationPage.astro';
import StickyContainer from '@/components/layouts/StickyContainer.astro';
import { Typography } from '@/components/ui/typography';
import i18next from 'i18next';
import BuildingAddress from '../BuildingAddress';
import CurrentStats from '../CurrentStats';
import OuterPartsButtonBar from './OuterPartsButtonBar';
import OuterPartsStepForm from './OuterPartsStepForm';
import OuterSectionNav from './OuterSectionNav';
---

<EnergyCalculationPage step={3}>
  <ContentContainer>
    <Typography as="h1" variant="h2">
      {i18next.t('energyCalculation:outerParts.title')}
    </Typography>
    <BuildingAddress client:only="react" />
  </ContentContainer>
  <StickyContainer padding="pt-4 pb-5" compactWhenStuck>
    <CurrentStats client:only="react" />
    <div class="mt-8">
      <OuterSectionNav client:only="react" />
    </div>
    <Fragment slot="compact">
      <CurrentStats compact client:only="react" />
      <div class="mt-4">
        <OuterSectionNav client:only="react" />
      </div>
    </Fragment>
  </StickyContainer>
  <ContentContainer>
    <OuterPartsStepForm client:only="react" />
    <OuterPartsButtonBar className="mt-8" client:load />
  </ContentContainer>
</EnergyCalculationPage>
