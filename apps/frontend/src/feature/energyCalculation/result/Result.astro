---
import ContentContainer from '@/components/layouts/ContentContainer.astro';
import EnergyCalculationPage from '@/components/layouts/EnergyCalculationPage.astro';
import FeedbackBubble from '@/components/layouts/FeedbackBubble';
import StickyContainer from '@/components/layouts/StickyContainer.astro';
import { Typography } from '@/components/ui/typography';
import i18next from 'i18next';
import BuildingAddress from '../BuildingAddress';
import ButtonBar from '../ButtonBar';
import RenovationStats from '../renovation/RenovationStats';
import RenovationSummaryDialog from '../renovation/RenovationSummaryDialog';
import EnergyClassDisplay from './EnergyClassDisplay';
import { NextStepsSection } from './NextStepsSection';
import { SubsidySection } from './SubsidySection';
---

<EnergyCalculationPage step={7}>
  <ContentContainer>
    <div
      class="flex flex-wrap items-start justify-between gap-3 sm:items-center"
    >
      <div>
        <Typography as="h1" variant="h2">
          {i18next.t('energyCalculation:result.title')}
        </Typography>
        <BuildingAddress client:only="react" />
      </div>
      <RenovationSummaryDialog client:load />
    </div>
  </ContentContainer>
  <StickyContainer compactWhenStuck>
    <RenovationStats client:only="react" />
    <Fragment slot="compact">
      <RenovationStats compact client:only="react" />
    </Fragment>
  </StickyContainer>
  <ContentContainer>
    <Typography as="h2" variant="h3" className="mt-2">
      {i18next.t('energyCalculation:result.energyEfficiencyClass')}
    </Typography>
    <div class="mt-4"><EnergyClassDisplay client:load /></div>
    <SubsidySection client:only="react" />
    <NextStepsSection client:load />
    <ButtonBar backTextKey="backFromResults" className="mt-8" client:load />
  </ContentContainer>
  <FeedbackBubble client:load />
</EnergyCalculationPage>
