---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
import ContentContainer from '@/components/layouts/ContentContainer.astro';
import Header from '@/components/layouts/header/Header.astro';
import Footer from '@/components/layouts/Footer.astro';
import { Typography } from '@/components/ui/typography';
import i18next from 'i18next';
import type { GetStaticPaths } from 'astro';
import { buildStaticPaths } from '@/i18n/routing';

export const getStaticPaths = (() => {
  return buildStaticPaths();
}) satisfies GetStaticPaths;

const labelEmail = i18next.t('common:imprint.labels.email');
const labelInternet = i18next.t('common:imprint.labels.internet');

const contactEmail = i18next.t('common:imprint.contact.email');
const publisherEmail = i18next.t('common:imprint.publisher.email');
const publisherWebsite = i18next.t('common:imprint.publisher.website');
const responsibleEmail = i18next.t('common:imprint.responsible.email');
const responsibleWebsite = i18next.t('common:imprint.responsible.website');
const administrationEmail = i18next.t('common:imprint.administration.email');
const administrationWebsite = i18next.t(
  'common:imprint.administration.website',
);
---

<BaseLayout>
  <Header />
  <main class="relative min-h-screen shrink-0 pt-(--title-height)">
    <ContentContainer class="flex flex-col gap-10 py-10 md:py-16">
      <Typography as="h1" variant="h1">
        {i18next.t('common:imprint.title')}
      </Typography>

      <section class="flex flex-col gap-4">
        <Typography as="h2" variant="lead">
          {i18next.t('common:imprint.contactIntro')}
        </Typography>
        <div class="flex flex-col gap-1">
          <Typography variant="body">
            {labelEmail}:{' '}
            <a
              href={`mailto:${contactEmail}`}
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {contactEmail}
            </a>
          </Typography>
          <Typography variant="body">
            {i18next.t('common:imprint.labels.phone')}:{' '}
            {i18next.t('common:imprint.contact.phone')}
          </Typography>
          <Typography variant="body">
            {i18next.t('common:imprint.labels.fax')}:{' '}
            {i18next.t('common:imprint.contact.fax')}
          </Typography>
        </div>
        <Typography variant="body" className="whitespace-pre-line">
          {i18next.t('common:imprint.contact.address')}
        </Typography>
      </section>

      <section class="flex flex-col gap-4">
        <Typography as="h2" variant="h3">
          {i18next.t('common:imprint.publisher.title')}
        </Typography>
        <Typography variant="body" className="whitespace-pre-line">
          {i18next.t('common:imprint.publisher.address')}
        </Typography>
        <div class="flex flex-col gap-1">
          <Typography variant="body">
            {labelEmail}:{' '}
            <a
              href={`mailto:${publisherEmail}`}
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {publisherEmail}
            </a>
          </Typography>
          <Typography variant="body">
            {labelInternet}:{' '}
            <a
              href={`https://${publisherWebsite}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {publisherWebsite}
            </a>
          </Typography>
        </div>
        <Typography variant="body">
          {i18next.t('common:imprint.publisher.legalForm')}
        </Typography>
        <Typography variant="body">
          {i18next.t('common:imprint.publisher.vatId')}
        </Typography>
      </section>

      <section class="flex flex-col gap-4">
        <Typography as="h2" variant="h3">
          {i18next.t('common:imprint.responsible.title')}
        </Typography>
        <Typography variant="body" className="whitespace-pre-line">
          {i18next.t('common:imprint.responsible.address')}
        </Typography>
        <div class="flex flex-col gap-1">
          <Typography variant="body">
            {labelEmail}:{' '}
            <a
              href={`mailto:${responsibleEmail}`}
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {responsibleEmail}
            </a>
          </Typography>
          <Typography variant="body">
            {labelInternet}:{' '}
            <a
              href={`https://${responsibleWebsite}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {responsibleWebsite}
            </a>
          </Typography>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <Typography as="h2" variant="h3">
          {i18next.t('common:imprint.administration.title')}
        </Typography>
        <Typography variant="body" className="whitespace-pre-line">
          {i18next.t('common:imprint.administration.address')}
        </Typography>
        <div class="flex flex-col gap-1">
          <Typography variant="body">
            {labelEmail}:{' '}
            <a
              href={`mailto:${administrationEmail}`}
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {administrationEmail}
            </a>
          </Typography>
          <Typography variant="body">
            {labelInternet}:{' '}
            <a
              href={`https://${administrationWebsite}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:text-primary-hover underline transition-colors"
            >
              {administrationWebsite}
            </a>
          </Typography>
        </div>
        <Typography variant="body">
          {i18next.t('common:imprint.administration.vatId')}
        </Typography>
      </section>
    </ContentContainer>
  </main>
  <Footer />
</BaseLayout>
